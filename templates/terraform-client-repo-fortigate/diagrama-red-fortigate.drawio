                <mxCell id="f4" edge="1" parent="1" source="net-att" style="html=1;rounded=0;endArrow=block;strokeWidth=3;strokeColor=#1565C0;fontSize=14;fontStyle=1;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.833;entryY=1;exitPerimeter=0;entryPerimeter=0;" target="net-fg" value="4">
